\nvar2 <- function(x)\n{\n    n <- length(x)\n    \n    sum((x-mean(x))^2) / (n-1)\n}\n\nx <- c(1,2,3)\n\nc(var1(x),var2(x),var(x))\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] 1 1 1\n```\n\n\n:::\n\n```{.r .cell-code}\nx <- c(1,2,3) + 1e10\n\nc(var1(x),var2(x),var(x))\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] -32768      1      1\n```\n\n\n:::\n:::\n\n\n# Overflow and underflow \n\n::: {.cell}\n\n```{.r .cell-code}\n## demo of overflow problem: avoid Inf/Inf, 0/0\np1 <- function(theta)\n{\n    exp(theta)/(1+exp(theta))\n}\n\np2 <- function(theta)\n{\n    1/(1+exp(-theta))\n}\n\n\ntheta <- 2000\n\np1(theta)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] NaN\n```\n\n\n:::\n\n```{.r .cell-code}\np2(theta)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] 1\n```\n\n\n:::\n\n```{.r .cell-code}\ntheta <- -2000\n\np1(theta)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] 0\n```\n\n\n:::\n\n```{.r .cell-code}\np2(theta)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] 0\n```\n\n\n:::\n:::\n\n# Use logarithm to handle overflow and underflow numbers\n\n\n::: {.cell}\n\n```{.r .cell-code}\nlog_x <- 800\n\nx <- exp(log_x)\n\nx\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] Inf\n```\n\n\n:::\n\n```{.r .cell-code}\nlog_y <- 805\n\ny <- exp(log_y)\n\ny\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] Inf\n```\n\n\n:::\n\n```{.r .cell-code}\nx/y\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] NaN\n```\n\n\n:::\n\n```{.r .cell-code}\nlog_xovery <- log_x- log_y\n\nlog_xovery\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] -5\n```\n\n\n:::\n\n```{.r .cell-code}\nexp(log_xovery)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] 0.006737946999085467000845\n```\n\n\n:::\n\n```{.r .cell-code}\n#looking for log of sum of numbers in logarithm\n\nlog_sum_exp <- function(log_x)\n{\n    max_log_x <- max(log_x)\n    \n    max_log_x + log( sum(exp(log_x - max_log_x) ))\n}\n\nlog_x <- c(2000,2010,2030)\n\nexp(log_x)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] Inf Inf Inf\n```\n\n\n:::\n\n```{.r .cell-code}\nlog_sum_exp(log_x)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] 2030.000000002061142368\n```\n\n\n:::\n\n```{.r .cell-code}\nlog_x <- - c(2000,2010,2030)\n\nexp(log_x)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] 0 0 0\n```\n\n\n:::\n\n```{.r .cell-code}\nlog_sum_exp(log_x)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] -1999.99995460110062595\n```\n\n\n:::\n\n```{.r .cell-code}\nlog_minus_exp <- function(log_x,log_y)\n    \n{  if(log_x < log_y)\n    stop(\"The first argument is bigger than the second\")\n    \n    log_x + log(1-exp(log_y-log_x))\n    \n}\n\nlog_minus_exp(2020,2000)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] 2019.999999997938857632\n```\n\n\n:::\n\n```{.r .cell-code}\nexp(2000) - exp(1999)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n[1] NaN\n```\n\n\n:::\n:::\n\n\n",
